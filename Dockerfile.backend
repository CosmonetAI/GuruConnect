FROM python:3.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN groupadd --gid 10001 guruconnect && useradd --uid 10001 --gid 10001 --no-create-home guruconnect
WORKDIR /app/services/backend
COPY services/backend/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY services/backend/recorder ./recorder
COPY services/backend/supabase-ca.crt ./supabase-ca.crt
COPY scripts/migrate.py /app/scripts/migrate.py
COPY supabase/migrations /app/supabase/migrations
USER 10001:10001
EXPOSE 10000
CMD ["python", "-m", "recorder.launch"]
