# Demo mode: set VITE_DEMO to true to store walk-ins in this browser.
VITE_DEMO=true

# Production: set VITE_DEMO=false and configure Supabase Auth + the migration in
# supabase/migrations. Assign app_metadata.role as reception, sales_agent,
# manager, or admin using a trusted server/admin process (never frontend code).
# Create walkin_sales_agents rows for active sales users through a trusted
# administrative process; the migration intentionally does not invent users.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
