{
  "name": "guruconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "build:production": "node scripts/build-production.mjs",
    "preview": "vite preview",
    "dev:api": "node scripts/run-backend.mjs api",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:database": "bash tests/database/run_native.sh",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "test:backend": "node scripts/check-backend.mjs",
    "contracts": "node scripts/generate-contracts.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "setup": "node scripts/setup-backend.mjs",
    "test:live-workspace": "node tests/browser/live-workspace.qa.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.2",
    "fake-indexeddb": "6.2.5",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
