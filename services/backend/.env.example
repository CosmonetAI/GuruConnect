ENVIRONMENT=development
# Percent-encode the database password, including @, #, %, / and ?.
# supabase-ca.crt is the public Supabase CA bundled in this backend folder.
DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=verify-full&sslrootcert=supabase-ca.crt
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
JWT_AUDIENCE=authenticated
# Optional explicit issuer; defaults to SUPABASE_URL/auth/v1
JWT_ISSUER=
CREDENTIAL_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_OUTSIDE_POSTGRES
CREDENTIAL_KEY_VERSION=1
CORS_ORIGINS=["http://127.0.0.1:5176","http://localhost:5176"]
STORAGE_BUCKET=recorder-audio
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
UPLOAD_MAX_BYTES=320044
RECORDING_MAX_SECONDS=7200
WINDOW_SECONDS=30
CONTEXT_SECONDS=2
SIGNED_URL_SECONDS=120
WORKER_LEASE_SECONDS=180
RATE_LIMIT_PER_MINUTE=120
