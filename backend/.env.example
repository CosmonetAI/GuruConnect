ENVIRONMENT=development
# Use Supabase Connect -> Connection pooling -> Session/Transaction pooler here.
# Keep the standard postgresql:// form; both GuruConnect and GG use this same URL.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=verify-full&sslrootcert=supabase-ca.crt
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
JWT_AUDIENCE=authenticated
JWT_ISSUER=
CREDENTIAL_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_OUTSIDE_POSTGRES
CREDENTIAL_KEY_VERSION=1
STORAGE_BUCKET=recorder-audio
CORS_ORIGINS=["http://127.0.0.1:5176","http://localhost:5176"]
TRUSTED_HOSTS=["localhost","127.0.0.1","::1"]
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
UPLOAD_MAX_BYTES=6000000
RECORDING_MAX_SECONDS=7200
WINDOW_SECONDS=30
CONTEXT_SECONDS=2
SIGNED_URL_SECONDS=120
WORKER_LEASE_SECONDS=180
RATE_LIMIT_PER_MINUTE=120
# GG Project / Zoho sales assistant settings
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
APP_TIMEZONE=Asia/Kolkata
ZOHO_REFRESH_CRON_SECRET=replace-with-a-long-random-secret
